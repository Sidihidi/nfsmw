+/* Subroutine of gek_expand_builtin for scalar SFmode unops without an Rc
+   operand (SN-PoC: __builtin_frsqrte, __builtin_fres).  */
+
+static rtx gek_expand_sf_unop_builtin (enum insn_code icode, tree arglist, rtx target)
+{
+  tree arg0 = TREE_VALUE (arglist);
+  rtx op0 = expand_expr (arg0, NULL_RTX, VOIDmode, 0);
+  rtx pat;
+
+  if (! target
+      || GET_MODE (target) != SFmode)
+    target = gen_reg_rtx (SFmode);
+
+  op0 = copy_to_mode_reg (SFmode, op0);
+
+  pat = GEN_FCN (icode) (target, op0);
+  if (! pat)
+    return 0;
+  emit_insn (pat);
+  return target;
+} ;
+
 /* Expand an expression EXP that calls a built-in function,
    with result going to TARGET if that's convenient
    (and in mode MODE if that's convenient).
@@ -6829,6 +6870,14 @@
